# Python bytecode and extension modules
__pycache__/
*.py[cod]
*$py.class
*.so

# Python tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.pyre/
.pytype/
.dmypy.json
dmypy.json

# Coverage and reports
.coverage
.coverage.*
coverage.xml
htmlcov/

# Build and packaging artifacts
build/
dist/
site/
*.egg
*.egg-info/
.eggs/
pip-wheel-metadata/

# Virtual environments and local env files
.venv/
venv/
env/
ENV/
.env
.env.*
.python-version

# Jupyter
.ipynb_checkpoints/
notebooks/

# IDE/editor
.idea/
.vscode/

# OS/system files
.DS_Store
Thumbs.db
*Zone.Identifier

# Logs and temporary files
*.log
*.tmp
*.temp
tmp/

# Generated/runtime folders
runs/
work/
out/
work_*/
out_*/

# Local Codex metadata
.codex

# Ignore all local configs except vanA and examples
config/*.yaml
config/*.yml
!config/vanA.production.yaml
!config/examples/
!config/examples/**
!config/*.example.yaml
!config/*.example.yml

# Ignore all data by default
data/*

# Keep only source/test data needed in repo
!data/blastdb/
!data/blastdb/README.md
!data/blast_test_db/
!data/blast_test_db/**
!data/local_negative_panel.fna
!data/target_gene_contexts.fna

# Ignore generated result files anywhere under data
data/**/*_top_pairs.json
data/**/*_top_pairs.csv
data/**/*_top_pairs.tsv
data/**/*_top_pairs_report.txt

# Research materials and document binaries
lit/
*.pdf