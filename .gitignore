# Python bytecode and native extensions
__pycache__/
*.py[cod]
*.pyo
*.pyd
*$py.class
*.so

# Python tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.pyre/
.pytype/
.cache/
.dmypy.json
dmypy.json

# Coverage and test artifacts
.coverage
.coverage.*
coverage.xml
htmlcov/

# Build and packaging artifacts
build/
dist/
site/
*.egg
*.egg-info/
.eggs/
pip-wheel-metadata/

# Virtual environments and local environment files
.venv/
venv/
env/
ENV/
.env
.env.*
.python-version

# Jupyter and notebooks
.ipynb_checkpoints/
notebooks/

# IDE/editor metadata
.idea/
.vscode/

# OS/system files
.DS_Store
Thumbs.db
Desktop.ini
*Zone.Identifier

# Logs and temporary files
*.log
*.tmp
*.temp
tmp/
temp/

# Local Codex metadata
.codex

# Runtime and generated project outputs
/runs/
/work/
/out/
/reports/
/downloads/
/blastdb/
logs/
work_*/
out_*/

# Generated runtime snapshots inside data/
/data/work/
/data/out/
/data/data/
/data/synthetic/

# Local-only config overrides
/config/*.local.yaml
/config/*.local.yml
/config/*.private.yaml
/config/*.private.yml

# Data: ignore everything by default, keep only committed inputs and test fixtures
/data/*
!/data/blastdb/
!/data/blastdb/README.md
!/data/blast_test_db/
!/data/blast_test_db/**
!/data/local_negative_panel.fna
!/data/target_gene_contexts.fna

# Research and personal working materials
/lit/
